{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding.schema.json",
  "title": "Coding question metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "status",
    "difficulty",
    "expected_duration_minutes",
    "categories",
    "tags",
    "prerequisites",
    "related_questions",
    "source",
    "review",
    "last_updated",
    "content_file",
    "practice"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "type": {"const": "coding"},
    "title": {"$ref": "common.schema.json#/$defs/title"},
    "status": {"$ref": "common.schema.json#/$defs/status"},
    "difficulty": {"$ref": "common.schema.json#/$defs/difficulty"},
    "expected_duration_minutes": {"$ref": "common.schema.json#/$defs/duration"},
    "categories": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/slug_list"},
        {"minItems": 1}
      ]
    },
    "tags": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/slug_list"},
        {"minItems": 2}
      ]
    },
    "prerequisites": {"$ref": "common.schema.json#/$defs/question_id_list"},
    "related_questions": {"$ref": "common.schema.json#/$defs/question_id_list"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "review": {"$ref": "common.schema.json#/$defs/review"},
    "last_updated": {"$ref": "common.schema.json#/$defs/last_updated"},
    "content_file": {"$ref": "common.schema.json#/$defs/content_file"},
    "practice": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "cmake_target", "test_target"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^practice/questions/[a-z0-9-]+$"
        },
        "cmake_target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "test_target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        }
      }
    }
  }
}
