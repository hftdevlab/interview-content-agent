{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-stage-output.schema.json",
  "title": "Agent workflow stage result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary",
    "clarification_questions",
    "validation_commands",
    "memory_candidates"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["ready", "needs_clarification", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "clarification_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "validation_commands": {
      "type": "array",
      "items": {"type": "string"}
    },
    "memory_candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principle", "rationale", "question_types"],
        "properties": {
          "principle": {
            "type": "string",
            "minLength": 20,
            "maxLength": 240
          },
          "rationale": {
            "type": "string",
            "minLength": 20,
            "maxLength": 500
          },
          "question_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["all", "coding", "system_design", "fundamentals"]
            }
          }
        }
      }
    }
  }
}
